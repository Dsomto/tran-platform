# ─── Database ────────────────────────────────────────────
# MongoDB Atlas connection string. Include the database name in the path.
DATABASE_URL="mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/netforge?retryWrites=true&w=majority"

# ─── Auth ─────────────────────────────────────────────────
# Long random hex string. Generate with: openssl rand -hex 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Independent HMAC secrets for advanced assignment allocation and artifact
# contents. Generate each separately with: openssl rand -hex 32
ADVANCED_VARIANT_SECRET="replace-with-a-separate-long-random-string"
ADVANCED_ARTIFACT_SECRET="replace-with-another-separate-long-random-string"
# In production set these to your real domain (e.g. https://therootaccessnetwork.com)
NEXTAUTH_URL="http://localhost:3000"
PUBLIC_APP_URL="http://localhost:3000"

# ─── Private advanced artifact delivery ──────────────────
# Local/persistent-volume mode. Never point this at public/.
ADVANCED_ARTIFACT_ROOT="/srv/netforge/advanced-artifacts/delivery"
# Or proxy from a private object gateway. Set both values to use this mode.
# ADVANCED_ARTIFACT_ORIGIN="https://private-artifacts.internal"
# ADVANCED_ARTIFACT_ORIGIN_TOKEN="replace-with-private-origin-token"

# ─── Email (Zoho SMTP) ───────────────────────────────────
SMTP_HOST="smtp.zoho.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# ─── Cohort channel (included in passed-stage emails) ─────
# Paste your Slack workspace invite link here (or a Discord invite).
# Leave blank to hide the channel button from passed-stage emails.
SLACK_CHANNEL_URL=""

# ─── Cron ─────────────────────────────────────────────────
# Protects /api/cron/email-drain from being hit by anyone.
# Vercel Cron automatically sends this as "Authorization: Bearer $CRON_SECRET".
# Generate with: openssl rand -hex 32
CRON_SECRET="replace-with-a-long-random-string"
